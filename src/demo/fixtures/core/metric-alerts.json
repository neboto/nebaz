{
  "value": [
    {
      "id": "/subscriptions/{{prod}}/resourceGroups/rg-orders-prod/providers/Microsoft.Insights/metricAlerts/orders-api-requests-dropped",
      "name": "orders-api-requests-dropped",
      "type": "Microsoft.Insights/metricAlerts",
      "location": "global",
      "tags": {
        "env": "prod"
      },
      "properties": {
        "description": "Requests to ca-orders-api fell below 200 per 15 minutes (normally ~25,000).",
        "severity": 1,
        "enabled": true,
        "scopes": [
          "/subscriptions/{{prod}}/resourceGroups/rg-orders-prod/providers/Microsoft.App/containerApps/ca-orders-api"
        ],
        "evaluationFrequency": "PT1M",
        "windowSize": "PT15M",
        "criteria": {
          "allOf": [
            {
              "threshold": 200,
              "name": "Metric1",
              "metricNamespace": "Microsoft.App/containerApps",
              "metricName": "Requests",
              "operator": "LessThan",
              "timeAggregation": "Total",
              "criterionType": "StaticThresholdCriterion",
              "dimensions": [],
              "skipMetricValidation": false
            }
          ],
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria"
        },
        "autoMitigate": true,
        "targetResourceType": "Microsoft.App/containerApps",
        "targetResourceRegion": "westeurope",
        "actions": [
          {
            "actionGroupId": "/subscriptions/{{prod}}/resourceGroups/rg-orders-prod/providers/Microsoft.Insights/actionGroups/ag-orders-oncall",
            "webHookProperties": {}
          }
        ]
      }
    },
    {
