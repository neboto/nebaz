{
  "name": "vmss-legacy-web",
  "id": "/subscriptions/{{prod}}/resourceGroups/rg-legacy-prod/providers/Microsoft.Compute/virtualMachineScaleSets/vmss-legacy-web",
  "type": "Microsoft.Compute/virtualMachineScaleSets",
  "location": "westeurope",
  "tags": {
    "env": "prod",
    "team": "legacy",
    "owner": "legacy-ops@contoso.com",
    "costCenter": "CC-4410"
  },
  "sku": {
    "name": "Standard_D2s_v5",
    "tier": "Standard",
    "capacity": 3
  },
  "zones": [
    "1",
    "2",
    "3"
  ],
  "identity": {
    "type": "SystemAssigned",
    "principalId": "c4e1a7d2-5b39-4f80-9e16-2a7d3c8b5f41",
    "tenantId": "{{tenant}}"
  },
  "properties": {
    "singlePlacementGroup": false,
    "orchestrationMode": "Uniform",
    "upgradePolicy": {
      "mode": "Manual"
    },
    "scaleInPolicy": {
      "rules": [
        "Default"
      ],
      "forceDeletion": false
    },
    "automaticRepairsPolicy": {
      "enabled": false
    },
    "virtualMachineProfile": {
      "osProfile": {
        "computerNamePrefix": "legacyweb",
        "adminUsername": "azureuser",
        "linuxConfiguration": {
          "disablePasswordAuthentication": true,
          "provisionVMAgent": true
        },
        "secrets": [],
        "allowExtensionOperations": true
      },
      "storageProfile": {
        "osDisk": {
          "osType": "Linux",
          "createOption": "FromImage",
          "caching": "ReadWrite",
          "managedDisk": {
            "storageAccountType": "Premium_LRS"
          },
          "diskSizeGB": 30
        },
        "imageReference": {
          "publisher": "Canonical",
          "offer": "0001-com-ubuntu-server-jammy",
          "sku": "22_04-lts-gen2",
          "version": "22.04.202410020"
        },
        "diskControllerType": "SCSI"
      },
      "networkProfile": {
        "networkInterfaceConfigurations": [
          {
            "name": "nic-legacy-web",
            "properties": {
              "primary": true,
              "enableAcceleratedNetworking": true,
              "disableTcpStateTracking": false,
              "dnsSettings": {
                "dnsServers": []
              },
              "enableIPForwarding": false,
              "ipConfigurations": [
                {
                  "name": "ipconfig1",
                  "properties": {
                    "primary": true,
                    "subnet": {
                      "id": "/subscriptions/{{prod}}/resourceGroups/rg-network-prod/providers/Microsoft.Network/virtualNetworks/vnet-hub-prod/subnets/snet-compute"
                    },
                    "privateIPAddressVersion": "IPv4"
                  }
                }
              ]
            }
          }
        ]
      },
      "diagnosticsProfile": {
        "bootDiagnostics": {
          "enabled": true
        }
      },
      "extensionProfile": {
        "extensions": [
          {
            "name": "AzureMonitorLinuxAgent",
            "properties": {
              "autoUpgradeMinorVersion": true,
              "enableAutomaticUpgrade": true,
              "publisher": "Microsoft.Azure.Monitor",
              "type": "AzureMonitorLinuxAgent",
              "typeHandlerVersion": "1.33"
            }
          },
          {
            "name": "HealthExtension",
            "properties": {
              "autoUpgradeMinorVersion": true,
              "publisher": "Microsoft.ManagedServices",
              "type": "ApplicationHealthLinux",
              "typeHandlerVersion": "2.0",
              "settings": {
                "protocol": "http",
                "port": 8080,
                "requestPath": "/healthz"
              }
            }
          },
          {
            "name": "install-portal",
            "properties": {
              "autoUpgradeMinorVersion": true,
              "publisher": "Microsoft.Azure.Extensions",
              "type": "CustomScript",
              "typeHandlerVersion": "2.1",
              "settings": {
                "commandToExecute": "bash install-portal.sh --env prod"
              }
            }
          }
        ]
      },
      "securityProfile": {
        "uefiSettings": {
          "secureBootEnabled": true,
          "vTpmEnabled": true
        },
        "securityType": "TrustedLaunch"
      },
      "priority": "Regular"
    },
    "provisioningState": "Succeeded",
    "overprovision": true,
    "doNotRunExtensionsOnOverprovisionedVMs": false,
    "uniqueId": "5d0c7b3e-8a21-4f6c-b9e4-1c3a7f2d8e60",
    "zoneBalance": true,
    "platformFaultDomainCount": 1,
    "timeCreated": "{{iso:now-540d}}"
  }
}
