{
  "id": "/subscriptions/{{prod}}/resourceGroups/rg-orders-prod/providers/Microsoft.Logic/workflows/la-invoice-intake",
  "name": "la-invoice-intake",
  "type": "Microsoft.Logic/workflows",
  "location": "westeurope",
  "tags": {
    "app": "orders",
    "env": "prod"
  },
  "properties": {
    "provisioningState": "Succeeded",
    "createdTime": "{{iso:now-160d}}",
    "changedTime": "{{iso:now-21d}}",
    "state": "Enabled",
    "version": "08584690112874455102",
    "accessEndpoint": "https://prod-27.westeurope.logic.azure.com:443/workflows/a83e01f7c2d94b0e9e55",
    "endpointsConfiguration": {
      "workflow": {
        "accessEndpointIpAddresses": [
          {
            "address": "13.95.155.53"
          },
          {
            "address": "52.174.54.218"
          }
        ],
        "outgoingIpAddresses": [
          {
            "address": "13.95.147.65"
          },
          {
            "address": "23.97.218.130"
          }
        ]
      },
      "connector": {
        "outgoingIpAddresses": [
          {
            "address": "13.69.227.208/28"
          },
          {
            "address": "40.115.50.13"
          }
        ]
      }
    },
    "accessControl": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "type": "Object",
          "defaultValue": {}
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Http",
          "inputs": {
            "method": "POST",
            "schema": {
              "type": "object",
              "properties": {
                "invoiceId": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "actions": {
        "Parse_invoice": {
          "type": "ParseJson",
          "runAfter": {},
          "inputs": {
            "content": "@triggerBody()",
            "schema": {}
          }
        },
        "Check_amount": {
          "type": "If",
          "runAfter": {
            "Parse_invoice": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "greater": [
                  "@body('Parse_invoice')?['amount']",
                  10000
                ]
              }
            ]
          },
          "actions": {
            "Queue_for_approval": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['servicebus']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/@{encodeURIComponent('invoices-approval')}/messages",
                "body": {
                  "ContentData": "@base64(triggerBody())"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              }
            }
          },
          "else": {
            "actions": {
              "Queue_for_payment": {
                "type": "ApiConnection",
                "inputs": {
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['servicebus']['connectionId']"
                    }
                  },
                  "method": "post",
                  "path": "/@{encodeURIComponent('invoices-payment')}/messages",
                  "body": {
                    "ContentData": "@base64(triggerBody())"
                  }
                }
              }
            }
          }
        },
        "Response": {
          "type": "Response",
          "kind": "Http",
          "runAfter": {
            "Check_amount": [
              "Succeeded"
            ]
          },
          "inputs": {
            "statusCode": 202
          }
        }
      },
      "outputs": {}
    },
    "parameters": {
      "$connections": {
        "value": {
          "servicebus": {
            "connectionId": "/subscriptions/{{prod}}/resourceGroups/rg-orders-prod/providers/Microsoft.Web/connections/servicebus-orders",
            "connectionName": "servicebus-orders",
            "id": "/subscriptions/{{prod}}/providers/Microsoft.Web/locations/westeurope/managedApis/servicebus"
          }
        }
      }
    }
  }
}
