          "triggers": {
            "Every_15_minutes": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Minute",
                "interval": 15
              }
            }
          },
          "actions": {
            "Get_late_orders": {
              "type": "Http",
              "runAfter": {},
              "inputs": {
                "method": "GET",
                "uri": "https://ca-orders-api.wonderfulsea-7c1e2a9b.westeurope.azurecontainerapps.io/orders/late?code=demo-planted-workflow-code",
                "headers": {
                  "x-orders-key": "@parameters('ordersApiKey')"
                }
              }
            },
            "For_each_order": {
              "type": "Foreach",
              "foreach": "@body('Get_late_orders')",
              "runAfter": {
                "Get_late_orders": [
                  "Succeeded"
                ]
              },
              "actions": {
                "Send_an_email": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['office365']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/v2/Mail",
                    "body": {
                      "To": "orders-desk@contoso.com",
                      "Subject": "Late order @{items('For_each_order')?['id']}",
                      "Body": "demo-planted-workflow-body"
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
