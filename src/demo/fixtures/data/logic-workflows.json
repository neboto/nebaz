          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            }
          },
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "method": "POST",
                "schema": {
                  "type": "object",
                  "properties": {
                    "invoiceId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "actions": {
            "Parse_invoice": {
              "type": "ParseJson",
              "runAfter": {},
              "inputs": {
                "content": "@triggerBody()",
                "schema": {}
              }
            },
            "Check_amount": {
              "type": "If",
              "runAfter": {
                "Parse_invoice": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@body('Parse_invoice')?['amount']",
                      10000
                    ]
                  }
                ]
              },
              "actions": {
                "Queue_for_approval": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['servicebus']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/@{encodeURIComponent('invoices-approval')}/messages",
                    "body": {
                      "ContentData": "@base64(triggerBody())"
                    }
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs"
                      ]
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Queue_for_payment": {
                    "type": "ApiConnection",
                    "inputs": {
                      "host": {
                        "connection": {
                          "name": "@parameters('$connections')['servicebus']['connectionId']"
                        }
                      },
                      "method": "post",
                      "path": "/@{encodeURIComponent('invoices-payment')}/messages",
                      "body": {
                        "ContentData": "@base64(triggerBody())"
                      }
                    }
                  }
                }
              }
            },
            "Response": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {
                "Check_amount": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "statusCode": 202
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "servicebus": {
